<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Вложенный StructureTest не должен попадать в glob основного проекта
         (иначе его obj\*.AssemblyInfo.cs даёт CS0579 в _wpftmp-сборке). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StructureTest\**;Updater\**</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.17763.0 — нужен для WinRT toast-уведомлений
         (Windows.UI.Notifications) в Services/ToastHelper.cs. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Трей: System.Windows.Forms.NotifyIcon (в WPF-UI 3.0.4 TaskbarIcon нет —
         это API из WPF-UI 4.x). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ImpactProConfig</RootNamespace>
    <AssemblyName>ImpactProConfig</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <!-- Портативная сборка обязана быть self-contained: build-portable.ps1 пакует
         publish/ как есть, и без этого флага архив уходит без рантайма .NET —
         приложение не запустится на машине без установленного Desktop Runtime.
         Раньше флаг передавался только руками в команде publish, из-за чего
         релиз однажды собрался на 13 файлов вместо 472. -->
    <SelfContained>true</SelfContained>
    <Authors>ImpactProConfig</Authors>
    <Product>ARDOR GAMING Impact PRO Config</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms подмешивает System.Drawing и System.Windows.Forms в
         неявные using'и — они конфликтуют с Brush/Color/Point/ComboBox/Application
         из WPF. Убираем их глобально; трей использует явные using'и. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="hidusb.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Изображения корпусов мыши встраиваются в сборку
         (pack-URI /Assets/dev1.png | /Assets/dev2.png | /Assets/dev3.png).
         Источник ассетов: res\2Button\ установленного "Mouse Drive Beta.exe". -->
    <None Remove="Assets\dev1.png" />
    <None Remove="Assets\dev2.png" />
    <None Remove="Assets\dev3.png" />
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\dev1.png" />
    <Resource Include="Assets\dev2.png" />
    <Resource Include="Assets\dev3.png" />
    <!-- Иконка приложения: в ресурсах — для Window.Icon, в ApplicationIcon — для exe. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Updater.exe собирается тем же `dotnet publish` и кладётся рядом с основным
       exe: автообновлению нужен отдельный процесс-обновитель в одной папке
       (запущенный основной exe перезаписать нельзя). В релизный zip апдейтер
       попадает из publish/ (build-portable.ps1 проверяет его наличие). -->
  <Target Name="PublishUpdater" AfterTargets="Publish">
    <MSBuild Projects="Updater\ImpactProConfig.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$(PublishDir)" />
  </Target>

</Project>


