<ui:FluentWindow x:Class="ImpactProConfig.MainWindow"
                 PreviewMouseWheel="UiWheelPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ImpactProConfig.ViewModels"
        xmlns:pages="clr-namespace:ImpactProConfig.Pages"
        mc:Ignorable="d"
        Title="ARDOR GAMING Impact PRO"
        Width="1080"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar
            Title="ARDOR GAMING Impact PRO"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True" />

        <!-- Шапка: профили слева, бейдж батареи и справка справа -->
        <Grid Grid.Row="1" Margin="18,4,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Профиль"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Margin="0,0,10,0" />

            <ComboBox Grid.Column="1"
                      Width="150"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Static vm:MainViewModel.Profiles}"
                      SelectedIndex="{Binding SelectedProfileIndex, Mode=TwoWay}"
                      IsEnabled="{Binding CanSwitchProfile}" />

            <!-- Бейдж батареи -->
            <Border Grid.Column="3"
                    CornerRadius="13"
                    Padding="14,6"
                    VerticalAlignment="Center"
                    Background="#22000000"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Battery1024"
                                   FontSize="18"
                                   Foreground="{Binding BatteryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Справка -->
            <ui:Button Grid.Column="4"
                       Content="Справка"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Click="Guide_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="QuestionCircle24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Навигация -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="RootNavigation_SelectionChanged">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Кнопки"
                    Tag="ButtonsPage"
                    TargetPageType="{x:Type pages:ButtonsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Сенсор и DPI"
                    Tag="DpiPage"
                    TargetPageType="{x:Type pages:DpiPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Настройки"
                    Tag="SettingsPage"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

        </ui:NavigationView>

        <!-- Строка состояния + «Применить» -->
        <Border Grid.Row="3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           Opacity="0.8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Плашка обновления. По умолчанию скрыта: DataTrigger
                     включает её только когда IsUpdateAvailable = True. -->
                <ui:InfoBar Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,8,0,0"
                            Severity="Info"
                            Title="Доступна новая версия"
                            IsClosable="True"
                            Message="{Binding UpdateMessage}">
                    <ui:InfoBar.Style>
                        <Style TargetType="ui:InfoBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:InfoBar.Style>
                    <!-- Кнопку ставим отдельной строкой: у ui:InfoBar в WPF-UI 3.0.4
                         нет свойства Action (оно появилось в 4.x). -->
                    <ui:Button Content="Скачать и обновить"
                               Click="Update_Click"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right" />
                </ui:InfoBar>

                <Border Grid.Row="0" Grid.Column="1"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{Binding AccentBrush}"
                    Opacity="0.18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="● есть несохранённые изменения"
                               Foreground="{Binding AccentBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Border>

                <ui:Button Grid.Column="2"
                           Appearance="Primary"
                           Content="Применить"
                           Foreground="White"
                           IsEnabled="{Binding CanApply}"
                           Click="Apply_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
