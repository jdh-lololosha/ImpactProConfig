<Page x:Class="ImpactProConfig.Pages.DpiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Сенсор и DPI">

    <Page.Resources>
        <!-- Карточка одной DPI-ступени: Button-обёртка для корректной работы Click + анимаций -->
        <Style x:Key="DpiCardButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="138" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder"
                                CornerRadius="8"
                                Background="#0AFFFFFF"
                                BorderBrush="{StaticResource ImpactStrokeBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </Border.RenderTransformOrigin>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1A000000" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ImpactAccentBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ImpactAccentColor}"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.95" />
                                    </Setter.Value>
                                </Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DpiPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="Effect.Opacity"
                                                             From="0.4" To="0.95" Duration="0:0:1.25"
                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="DpiPulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActiveByDevice}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ImpactAccentBrush}" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ImpactAccentColor}"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLevelActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.ColumnSpan="2">
                <ui:TextBlock Text="Сенсор и DPI" FontSize="28" FontWeight="SemiBold" />
                <ui:TextBlock Text="Уровни чувствительности, частота опроса, параметры сенсора и подсветка индикатора."
                              Opacity="0.6"
                              Margin="0,4,0,16" />
            </StackPanel>

            <!-- ===== Уровни DPI ===== -->
            <ui:Card Grid.Row="1" Grid.ColumnSpan="2" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Уровни DPI"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="Активных уровней"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="2"
                                  Width="120"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LevelItems}"
                                  SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding IsConnected}" />
                    </Grid>

                    <!-- Карточки ступеней -->
                    <ItemsControl ItemsSource="{Binding DpiSlots}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DpiCardButton}"
                                        Click="DpiCard_Click"
                                        Tag="{Binding SlotIndex}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Цветовая полоска ступени -->
                                        <Border Grid.Column="0"
                                                Margin="0,3,10,3"
                                                CornerRadius="2"
                                                Background="{Binding ColorBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{Binding ColorBrush}"
                                                     VerticalAlignment="Center" />
                                            <!-- Метка текущей ступени устройства -->
                                            <Border HorizontalAlignment="Right"
                                                    CornerRadius="8"
                                                    Padding="7,2"
                                                    Background="{DynamicResource ImpactAccentBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveByDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="активна"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DpiValue}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       LineHeight="28" />
                                            <TextBlock Text="DPI"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       Margin="5,0,0,4"
                                                       VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Точная подстройка выбранного уровня — единый монолитный блок -->
                    <Border Margin="0,12,0,0"
                            Padding="12,6"
                            CornerRadius="8"
                            Background="#0AFFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="−"
                                   Width="40"
                                   Height="34"
                                   FontSize="18"
                                   Click="DpiMinus_Click"
                                   ToolTip="Уменьшить на 50" />

                        <Slider Grid.Column="1"
                                Minimum="50"
                                Maximum="26000"
                                SmallChange="50"
                                LargeChange="500"
                                Value="{Binding SelectedDpiValue, Mode=TwoWay}"
                                Margin="14,0"
                                IsEnabled="{Binding IsConnected}" />

                        <ui:Button Grid.Column="2"
                                   Content="+"
                                   Width="40"
                                   Height="34"
                                   FontSize="18"
                                   Click="DpiPlus_Click"
                                   ToolTip="Увеличить на 50" />

                        <ui:NumberBox Grid.Column="3"
                                      Width="120"
                                      Margin="14,0,0,0"
                                      VerticalAlignment="Center"
                                      Minimum="50"
                                      Maximum="26000"
                                      SmallChange="50"
                                      Value="{Binding SelectedDpiValue, Mode=TwoWay}"
                                      IsEnabled="{Binding IsConnected}" />
                    </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ===== Частота опроса ===== -->
            <ui:Card Grid.Row="2" Padding="18" Margin="0,14,7,0">
                <StackPanel>
                    <TextBlock Text="Частота опроса"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="125 Гц"
                                     IsChecked="{Binding IsRate125, Mode=TwoWay}"
                                     Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="250 Гц"
                                     IsChecked="{Binding IsRate250, Mode=TwoWay}"
                                     Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="500 Гц"
                                     IsChecked="{Binding IsRate500, Mode=TwoWay}"
                                     Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="1000 Гц"
                                     IsChecked="{Binding IsRate1000, Mode=TwoWay}"
                                     Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="2000 Гц"
                                     IsChecked="{Binding IsRate2000, Mode=TwoWay}"
                                     IsEnabled="{Binding HighRatesAllowed}"
                                     Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="4000 Гц"
                                     IsChecked="{Binding IsRate4000, Mode=TwoWay}"
                                     IsEnabled="{Binding HighRatesAllowed}" />
                    </StackPanel>
                    <TextBlock Text="Выше частота — плавнее курсор, но выше нагрузка на радиоканал. 2000/4000 Гц доступны только на проводе."
                               Opacity="0.5"
                               FontSize="11"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- ===== Параметры сенсора ===== -->
            <ui:Card Grid.Row="2" Grid.Column="1" Padding="18" Margin="7,14,0,0">
                <StackPanel>
                    <TextBlock Text="Параметры сенсора"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Режим сенсора" VerticalAlignment="Center" Opacity="0.85" />
                        <ComboBox Grid.Column="1"
                                  Width="120"
                                  MinWidth="110"
                                  ItemsSource="{Binding SensorModeItems}"
                                  SelectedIndex="{Binding SensorModeIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Высота отрыва (LOD)" VerticalAlignment="Center" Opacity="0.85" />
                        <ComboBox Grid.Column="1"
                                  Width="120"
                                  MinWidth="110"
                                  ItemsSource="{Binding LodItems}"
                                  SelectedIndex="{Binding LodIndex, Mode=TwoWay}" />
                    </Grid>

                    <ui:ToggleSwitch Content="Сглаживание движений"
                                     IsChecked="{Binding SmoothEnable, Mode=TwoWay}"
                                     Margin="0,3" />
                    <ui:ToggleSwitch Content="Угловая привязка"
                                     IsChecked="{Binding AngleFixEnable, Mode=TwoWay}"
                                     Margin="0,3" />
                    <ui:ToggleSwitch Content="Синхронизация движения"
                                     IsChecked="{Binding MotionSyncEnable, Mode=TwoWay}"
                                     Margin="0,3" />
                </StackPanel>
            </ui:Card>

            <!-- ===== Подсветка DPI ===== -->
            <ui:Card Grid.Row="3" Grid.ColumnSpan="2" Padding="18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Режим -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Подсветка DPI"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <RadioButton Content="Выключить"
                                     IsChecked="{Binding IsLedOff, Mode=TwoWay}" />
                        <RadioButton Content="Постоянный свет"
                                     IsChecked="{Binding IsLedAlways, Mode=TwoWay}" />
                        <RadioButton Content="Дыхание"
                                     IsChecked="{Binding IsLedBreath, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Скорость -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <Grid>
                            <TextBlock Text="Скорость"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Text="{Binding LedSpeed, StringFormat={}{0}/5}" />
                        </Grid>
                        <Slider Minimum="1"
                                Maximum="5"
                                SmallChange="1"
                                LargeChange="1"
                                Value="{Binding LedSpeed, Mode=TwoWay}"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding IsConnected}" />
                        <TextBlock Text="Скорость эффекта «дыхание»."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Яркость -->
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="Яркость"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Text="{Binding LedBrightnessIndex, StringFormat={}{0}/10}" />
                        </Grid>
                        <Slider Minimum="1"
                                Maximum="10"
                                SmallChange="1"
                                LargeChange="2"
                                Value="{Binding LedBrightnessIndex, Mode=TwoWay}"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding IsConnected}" />
                        <TextBlock Text="Яркость индикатора активного уровня DPI."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>
