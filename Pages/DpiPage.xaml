<Page x:Class="ImpactProConfig.Pages.DpiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Сенсор и DPI">

    <Page.Resources>
        <!-- Масштаб карточки DPI при нажатии. Заморожен (frozen), иначе шаблон
             не шарится между экземплярами в ItemsControl. -->
        <ScaleTransform x:Key="DpiCardScaleNormal" ScaleX="1" ScaleY="1" />
        <ScaleTransform x:Key="DpiCardScalePressed" ScaleX="0.97" ScaleY="0.97" />

        <!-- Карточка одной DPI-ступени: Button-обёртка для корректной работы Click + анимаций -->
        <Style x:Key="DpiCardButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="138" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder"
                                CornerRadius="8"
                                Background="#0AFFFFFF"
                                BorderBrush="{StaticResource ImpactStrokeBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <StaticResource ResourceKey="DpiCardScaleNormal" />
                            </Border.RenderTransform>
                            <Border.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </Border.RenderTransformOrigin>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Нажатие переключает масштаб обычным Setter, как в
                                 MarkerButton: Storyboard с RenderTransform.ScaleX не мог
                                 разрешить цель в шаблоне и бросал InvalidOperationException
                                 из Storyboard.VerifyPathIsAnimatable. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="RenderTransform"
                                        Value="{StaticResource DpiCardScalePressed}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1A000000" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ImpactAccentBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ImpactAccentColor}"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.95" />
                                    </Setter.Value>
                                </Setter>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DpiPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="Effect.Opacity"
                                                             From="0.4" To="0.95" Duration="0:0:1.25"
                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="DpiPulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActiveByDevice}" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ImpactAccentBrush}" />
                                <Setter TargetName="CardBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ImpactAccentColor}"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLevelActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.ColumnSpan="2">
                <ui:TextBlock Text="Сенсор и DPI" FontSize="28" FontWeight="SemiBold" />
                <ui:TextBlock Text="Уровни чувствительности, частота опроса, параметры сенсора и подсветка индикатора."
                              Opacity="0.6"
                              Margin="0,4,0,16" />
            </StackPanel>

            <!-- ===== Уровни DPI ===== -->
            <ui:Card Grid.Row="1" Grid.ColumnSpan="2" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Уровни DPI"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="Активных уровней"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="2"
                                  Width="120"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LevelItems}"
                                  SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding IsConnected}" />
                    </Grid>

                    <!-- Карточки ступеней -->
                    <ItemsControl ItemsSource="{Binding DpiSlots}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DpiCardButton}"
                                        Click="DpiCard_Click"
                                        Tag="{Binding SlotIndex}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Цветовая полоска ступени -->
                                        <Border Grid.Column="0"
                                                Margin="0,3,10,3"
                                                CornerRadius="2"
                                                Background="{Binding ColorBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                            <!-- Кружок цвета ступени: клик открывает палитру -->
                                            <Button Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    Click="DpiColor_Click"
                                                    Tag="{Binding SlotIndex}"
                                                    ToolTip="Цвет ступени DPI. Клик — выбрать цвет.">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Ellipse Fill="{Binding ColorBrush}"
                                                                 Stroke="#66FFFFFF"
                                                                 StrokeThickness="1"
                                                                 Width="16"
                                                                 Height="16" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Метка текущей ступени устройства -->
                                            <Border HorizontalAlignment="Right"
                                                    CornerRadius="8"
                                                    Padding="7,2"
                                                    Background="{DynamicResource ImpactAccentBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveByDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="активна"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DpiValue}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       LineHeight="28" />
                                            <TextBlock Text="DPI"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       Margin="5,0,0,4"
                                                       VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Точная подстройка выбранного уровня — единый монолитный блок -->
                    <Border Margin="0,12,0,0"
                            Padding="12,6"
                            CornerRadius="8"
                            Background="#0AFFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Content="−"
                                   Width="40"
                                   Height="34"
                                   FontSize="18"
                                   Click="DpiMinus_Click"
                                   ToolTip="Уменьшить на 50" />

                        <Slider Grid.Column="1"
                                Minimum="50"
                                Maximum="26000"
                                SmallChange="50"
                                LargeChange="500"
                                Value="{Binding SelectedDpiValue, Mode=TwoWay}"
                                Margin="14,0"
                                IsEnabled="{Binding IsConnected}" />

                        <ui:Button Grid.Column="2"
                                   Content="+"
                                   Width="40"
                                   Height="34"
                                   FontSize="18"
                                   Click="DpiPlus_Click"
                                   ToolTip="Увеличить на 50" />

                        <ui:NumberBox Grid.Column="3"
                                      Width="120"
                                      Margin="14,0,0,0"
                                      VerticalAlignment="Center"
                                      Minimum="50"
                                      Maximum="26000"
                                      SmallChange="50"
                                      Value="{Binding SelectedDpiValue, Mode=TwoWay}"
                                      IsEnabled="{Binding IsConnected}" />
                    </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ===== Частота опроса ===== -->
            <ui:Card Grid.Row="2" Padding="18" Margin="0,14,7,0">
                <StackPanel>
                    <TextBlock Text="Частота опроса"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="125 Гц"
                                     IsChecked="{Binding IsRate125, Mode=TwoWay}"
                                     Margin="0,0,8,0"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="250 Гц"
                                     IsChecked="{Binding IsRate250, Mode=TwoWay}"
                                     Margin="0,0,8,0"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="500 Гц"
                                     IsChecked="{Binding IsRate500, Mode=TwoWay}"
                                     Margin="0,0,8,0"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="1000 Гц"
                                     IsChecked="{Binding IsRate1000, Mode=TwoWay}"
                                     Margin="0,0,8,0"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="2000 Гц"
                                     IsChecked="{Binding IsRate2000, Mode=TwoWay}"
                                     IsEnabled="{Binding HighRatesAllowed}"
                                     Margin="0,0,8,0"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                        <RadioButton Style="{StaticResource SegmentRadioButton}"
                                     Content="4000 Гц"
                                     IsChecked="{Binding IsRate4000, Mode=TwoWay}"
                                     IsEnabled="{Binding HighRatesAllowed}"
                                     ToolTip="Количество отчётов мыши в секунду. 1000 Гц даёт задержку 1 мс." />
                    </StackPanel>
                    <TextBlock Text="Выше частота — плавнее курсор, но выше нагрузка на радиоканал. 2000/4000 Гц доступны только на проводе."
                               Opacity="0.5"
                               FontSize="11"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- ===== Параметры сенсора ===== -->
            <ui:Card Grid.Row="2" Grid.Column="1" Padding="18" Margin="7,14,0,0">
                <StackPanel>
                    <TextBlock Text="Параметры сенсора"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Режим сенсора" VerticalAlignment="Center" Opacity="0.85" />
                        <ComboBox Grid.Column="1"
                                  Width="120"
                                  MinWidth="110"
                                  ItemsSource="{Binding SensorModeItems}"
                                  SelectedIndex="{Binding SensorModeIndex, Mode=TwoWay}"
                                  ToolTip="HP (High Performance) — максимальная производительность сенсора. LP (Low Power) — режим энергосбережения батареи." />
                    </Grid>

                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Высота отрыва (LOD)" VerticalAlignment="Center" Opacity="0.85" />
                        <ComboBox Grid.Column="1"
                                  Width="120"
                                  MinWidth="110"
                                  ItemsSource="{Binding LodItems}"
                                  SelectedIndex="{Binding LodIndex, Mode=TwoWay}"
                                  ToolTip="Дистанция отрыва мыши от коврика, на которой сенсор перестаёт считывать поверхность (1 мм — стандарт для киберспорта, 2 мм — для неровных ковриков)." />
                    </Grid>

                    <ui:ToggleSwitch Content="Сглаживание движений"
                                     IsChecked="{Binding SmoothEnable, Mode=TwoWay}"
                                     Margin="0,3"
                                     ToolTip="Аппаратная фильтрация микро-джиттера сенсора на высоких значениях DPI." />
                    <ui:ToggleSwitch Content="Угловая привязка"
                                     IsChecked="{Binding AngleFixEnable, Mode=TwoWay}"
                                     Margin="0,3"
                                     ToolTip="Искусственное выравнивание движения курсора по прямым горизонтальным и вертикальным линиям." />
                    <ui:ToggleSwitch Content="Синхронизация движения"
                                     IsChecked="{Binding MotionSyncEnable, Mode=TwoWay}"
                                     Margin="0,3"
                                     ToolTip="Синхронизирует считывание кадров сенсора PixArt 3395 с тактами опроса USB для максимальной плавности." />
                </StackPanel>
            </ui:Card>

            <!-- ===== Подсветка DPI ===== -->
            <ui:Card Grid.Row="3" Grid.ColumnSpan="2" Padding="18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Режим -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Подсветка DPI"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <RadioButton Content="Выключить"
                                     IsChecked="{Binding IsLedOff, Mode=TwoWay}" />
                        <RadioButton Content="Постоянный свет"
                                     IsChecked="{Binding IsLedAlways, Mode=TwoWay}" />
                        <RadioButton Content="Дыхание"
                                     IsChecked="{Binding IsLedBreath, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Скорость -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <Grid>
                            <TextBlock Text="Скорость"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Text="{Binding LedSpeed, StringFormat={}{0}/5}" />
                        </Grid>
                        <Slider Minimum="1"
                                Maximum="5"
                                SmallChange="1"
                                LargeChange="1"
                                Value="{Binding LedSpeed, Mode=TwoWay}"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding IsConnected}" />
                        <TextBlock Text="Скорость эффекта «дыхание»."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Яркость -->
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="Яркость"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Text="{Binding LedBrightness, StringFormat={}{0}/255}" />
                        </Grid>
                        <Slider Minimum="0"
                                Maximum="255"
                                SmallChange="1"
                                LargeChange="16"
                                Value="{Binding LedBrightness, Mode=TwoWay}"
                                Margin="0,14,0,0"
                                IsEnabled="{Binding IsConnected}" />
                        <TextBlock Text="Яркость индикатора активного уровня DPI."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ===== Палитра цвета ступени DPI ===== -->
            <Popup x:Name="ColorPopup"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   Closed="ColorPopup_Closed">
                <Border Background="{StaticResource ImpactSurfaceBrush}"
                        BorderBrush="{StaticResource ImpactStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="16"
                                          ShadowDepth="3"
                                          Direction="270"
                                          Opacity="0.6" />
                    </Border.Effect>
                    <StackPanel Width="240">
                        <TextBlock Text="Цвет ступени DPI"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,10" />

                        <!-- Быстрые пресеты -->
                        <WrapPanel Margin="0,0,0,12">
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#FF0000" Tag="#FF0000" Click="PresetColor_Click"
                                    ToolTip="Красный" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#FF8000" Tag="#FF8000" Click="PresetColor_Click"
                                    ToolTip="Оранжевый" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#FFFF00" Tag="#FFFF00" Click="PresetColor_Click"
                                    ToolTip="Жёлтый" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#00FF00" Tag="#00FF00" Click="PresetColor_Click"
                                    ToolTip="Зелёный" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#00FFFF" Tag="#00FFFF" Click="PresetColor_Click"
                                    ToolTip="Голубой" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#0000FF" Tag="#0000FF" Click="PresetColor_Click"
                                    ToolTip="Синий" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#8000FF" Tag="#8000FF" Click="PresetColor_Click"
                                    ToolTip="Фиолетовый" />
                            <Button Width="28" Height="28" Margin="0,0,6,6" Cursor="Hand"
                                    Background="#FFFFFF" Tag="#FFFFFF" Click="PresetColor_Click"
                                    ToolTip="Белый" />
                        </WrapPanel>

                        <!-- HEX-ввод -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEX" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                            <TextBox x:Name="ColorHexBox"
                                     Grid.Column="1"
                                     Padding="6,4"
                                     MaxLength="9"
                                     KeyDown="ColorHexBox_KeyDown"
                                     LostFocus="ColorHexBox_LostFocus"
                                     ToolTip="Цвет в формате #RRGGBB (например, #FF8000)." />
                        </Grid>

                        <!-- RGB-ввод -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="R" Opacity="0.7" FontSize="11" Margin="0,0,0,3" />
                                <ui:NumberBox x:Name="ColorRBox"
                                              Minimum="0" Maximum="255" SmallChange="1"
                                              ValueChanged="ColorRgbBox_ValueChanged"
                                              ToolTip="Компонента цвета 0–255." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="G" Opacity="0.7" FontSize="11" Margin="0,0,0,3" />
                                <ui:NumberBox x:Name="ColorGBox"
                                              Minimum="0" Maximum="255" SmallChange="1"
                                              ValueChanged="ColorRgbBox_ValueChanged"
                                              ToolTip="Компонента цвета 0–255." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="B" Opacity="0.7" FontSize="11" Margin="0,0,0,3" />
                                <ui:NumberBox x:Name="ColorBBox"
                                              Minimum="0" Maximum="255" SmallChange="1"
                                              ValueChanged="ColorRgbBox_ValueChanged"
                                              ToolTip="Компонента цвета 0–255." />
                            </StackPanel>
                        </Grid>

                        <ui:Button Content="Готово"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Right"
                                   Click="CloseColorPopup_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </ScrollViewer>
</Page>
