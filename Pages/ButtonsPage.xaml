<Page x:Class="ImpactProConfig.Pages.ButtonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Кнопки">

    <Page.Resources>
        <!-- Круглый маркер-номер на изображении мыши (22px, полупрозрачный) -->
        <Style x:Key="MarkerButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="MarkerBg"
                                    CornerRadius="11"
                                    Background="#991F1F1F"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1.5"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <!-- Выноска вниз (как в официальном софте) — только у маркера 6 (DPI).
                                 Позиция через RenderTransform: Margin больше ячейки (22px)
                                 обнулял бы размер при arrange. -->
                            <Path x:Name="LeaderLine"
                                  Width="9"
                                  Height="13"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M 4.5,0 L 4.5,13 M 0,8.5 L 4.5,13 L 9,8.5"
                                  Stroke="#B3FFFFFF"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  IsHitTestVisible="False"
                                  Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <TranslateTransform X="6.5" Y="23" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MarkerBg" Property="Background" Value="{DynamicResource ImpactAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MarkerBg" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MarkerBg" Property="Background" Value="{DynamicResource ImpactAccentBrush}" />
                                <Setter TargetName="MarkerBg" Property="BorderBrush" Value="White" />
                                <Setter TargetName="MarkerBg" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MarkerNumber}" Value="6">
                                <Setter TargetName="LeaderLine" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка кнопок -->
        <Style x:Key="ButtonRow" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#24E81123" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ImpactAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.ColumnSpan="2">
                <ui:TextBlock Text="Назначение кнопок" FontSize="28" FontWeight="SemiBold" />
                <ui:TextBlock Text="Нажмите номер на изображении мыши или строку в списке, затем выберите действие."
                              Opacity="0.6"
                              Margin="0,4,0,16" />
            </StackPanel>

            <!-- Изображение мыши с маркерами -->
            <ui:Card Grid.Row="1" Padding="16">
                <StackPanel>
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" MaxHeight="360">
                        <Grid x:Name="MouseGrid" Width="432" Height="356">
                        <!-- Мягкое красное свечение-подиум под корпусом мыши -->
                        <Ellipse Width="320"
                                 Height="104"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,4">
                            <!-- Подиум перекрашивается под выбранную тему. -->
                            <Ellipse.Fill>
                                <Binding Path="AccentGlowBrush" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Образ корпуса выбирается в Настройках; здесь он просто отображается. -->
                        <Image Source="{Binding MouseImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Маркеры 1..6. Позиции заморожены в коде (MainViewModel):
                             перетаскивание не подключено, изменить нельзя извне. -->
                        <ItemsControl ItemsSource="{Binding ButtonSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Canvas.Left" Value="{Binding MarkerLeft}" />
                                    <Setter Property="Canvas.Top" Value="{Binding MarkerTop}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MarkerButton}"
                                            Click="Marker_Click"
                                            Tag="{Binding MarkerNumber}"
                                            ToolTip="{Binding DisplayName}">
                                        <TextBlock Text="{Binding MarkerNumber}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </StackPanel>
        </ui:Card>

            <!-- Правая колонка -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">

                <!-- Время отклика кнопок -->
                <ui:Card Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Время отклика кнопок"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0"
                                    Maximum="20"
                                    SmallChange="1"
                                    LargeChange="5"
                                    Value="{Binding KeyDebounceMs, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KeyDebounceMs, StringFormat={}{0} мс}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="Диапазон 0–20 мс. Рекомендуется 8 мс."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Управление -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Управление"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,10" />
                        <StackPanel>
                            <ui:Button Content="Восстановить"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Click="Restore_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUndo24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Экспорт"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Click="Export_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Импорт"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Click="Import_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock Text="«Восстановить» отменяет несохранённые изменения. Экспорт/Импорт работают с файлом профиля формата официалки."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Список кнопок -->
            <ui:Card Grid.Row="2" Grid.ColumnSpan="2" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Список кнопок"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ButtonSlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ButtonRow}"
                                        MouseLeftButtonUp="Row_Click"
                                        Tag="{Binding MarkerNumber}"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="13"
                                                Background="#333333"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#333333" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ImpactAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MarkerNumber}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,12,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding FunctionText}"
                                                       Opacity="0.6"
                                                       FontSize="11" />
                                        </StackPanel>

                                        <ComboBox Grid.Column="2"
                                                  Width="220"
                                                  MinWidth="150"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding Actions}"
                                                  SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}">
                                            <!-- ItemTemplate вместо DisplayMemberPath: шаблон ComboBox
                                                 показывает SelectionBoxItemTemplate (= ItemTemplate),
                                                 DisplayMemberPath в закрытой строке игнорируется. -->
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>
