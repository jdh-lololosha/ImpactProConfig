<Page x:Class="ImpactProConfig.Pages.DpiIndicatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Индикатор DPI">

    <StackPanel Margin="24,16,24,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock Text="Индикатор DPI" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LedStatusText}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
        </Grid>

        <TextBlock Text="Светодиод сообщает активную ступень DPI."
                   Opacity="0.6"
                   Margin="0,4,0,16" />

        <!-- Карточка состояния LED -->
        <ui:Card Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Режим" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding LedMode}" FontSize="24" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Яркость" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding LedBrightness}" FontSize="24" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Скорость" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding LedBreathSpeed}" FontSize="24" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Состояние" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding LedStatusText}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
