<Page x:Class="ImpactProConfig.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Настройки">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="1000" HorizontalAlignment="Center">

            <ui:TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" />
            <ui:TextBlock Text="Информация об устройстве и системные параметры."
                          Opacity="0.6"
                          Margin="0,4,0,16" />

            <!-- Две колонки: слева устройство, справа системные параметры -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Информация об устройстве -->
                <ui:Card Grid.Column="0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Устройство"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Версия прошивки мыши"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MouseVersionText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Версия донгла"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DongleVersionText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Заряд батареи"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BatteryText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                </ui:Card>

                <!-- Правая колонка: спящий режим + автозагрузка -->
                <StackPanel Grid.Column="1" Margin="14,0,0,0">

            <!-- Спящий режим -->
            <ui:Card Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Спящий режим"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="Отключение подсветки при простое (allLedOffTime)."
                                   Opacity="0.5"
                                   FontSize="11"
                                   Margin="0,3,10,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Width="120"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SleepItems}"
                              SelectedIndex="{Binding SleepSelectedIndex, Mode=TwoWay}"
                              IsEnabled="{Binding IsConnected}" />
                </Grid>
            </ui:Card>

            <!-- Система -->
            <ui:Card Padding="18">
                <StackPanel>
                    <TextBlock Text="Система"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Запускать при загрузке системы"
                              IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                              FontSize="13" />
                    <TextBlock Text="Запись в автозагрузку применяется сразу, без «Применить»."
                               Opacity="0.5"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Уведомлять о низком заряде батареи (&lt; 15%)"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding LowBatteryAlertEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Телеметрия батареи -->
            <ui:Card Grid.Column="0" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Статистика батареи"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Скорость разряда считается по истории наблюдений (battery_stats.json), а не по одному замеру."
                               Opacity="0.5"
                               FontSize="11"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Текущий заряд"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BatteryText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Статус зарядки"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConnectionText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скорость разряда"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BatteryDrainText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Осталось примерно"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BatteryHoursLeftText}"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding BatteryStatsSamplesText}"
                               Opacity="0.45"
                               FontSize="11"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- OSD-оверлей -->
            <ui:Card Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="OSD-оверлей"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Всплывающий статус мыши: заряд, режим, подключение и остаток работы."
                               Opacity="0.5"
                               FontSize="11"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Монитор"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <ComboBox Grid.Column="1"
                                  Width="170"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding OsdMonitorItems}"
                                  SelectedIndex="{Binding OsdMonitorIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Позиция на экране"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <ComboBox Grid.Column="1"
                                  Width="170"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding OsdPositionItems}"
                                  SelectedIndex="{Binding OsdPositionIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Время показа"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <ComboBox Grid.Column="1"
                                  Width="170"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding OsdDurationItems}"
                                  SelectedIndex="{Binding OsdDurationIndex, Mode=TwoWay}" />
                    </Grid>

                    <ui:Button Content="Проверить OSD"
                               Click="CheckOsd_Click"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

                    <!-- Оформление: образ корпуса + акцент интерфейса -->
                    <ui:Card Grid.Column="0" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Оформление"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Образ корпуса мыши и акцентный цвет интерфейса. Меняется сразу, без «Применить»."
                                       Opacity="0.5"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Цвет мыши" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MouseSkinName}"
                                               Opacity="0.5"
                                               FontSize="11"
                                               Margin="0,2,10,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="170"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding MouseSkinItems}"
                                          SelectedIndex="{Binding SelectedMouseSkinIndex, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Тема интерфейса" VerticalAlignment="Center" />
                                    <TextBlock Text="Перекрашивает слайдеры, рамку активного DPI и подсветку под мышью."
                                               Opacity="0.5"
                                               FontSize="11"
                                               Margin="0,2,10,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="170"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AccentItems}"
                                          SelectedIndex="{Binding SelectedAccentIndex, Mode=TwoWay}" />
                            </Grid>

                            <!-- Палитра тем: быстрый выбор кликом по пятну.
                                 Tag = индекс пресета, обрабатывается кодом (без конвертеров). -->
                            <ItemsControl ItemsSource="{Binding AccentSwatches}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,10">
                                            <Border Width="46"
                                                    Height="26"
                                                    CornerRadius="6"
                                                    BorderBrush="#40FFFFFF"
                                                    BorderThickness="1"
                                                    Background="{Binding Brush}"
                                                    Tag="{Binding Index}"
                                                    MouseLeftButtonUp="AccentSwatch_Click"
                                                    ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="10"
                                                       Opacity="0.7"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
