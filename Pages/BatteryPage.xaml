<Page x:Class="ImpactProConfig.Pages.BatteryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:ImpactProConfig.Controls"
      Title="Батарея">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок + текущий заряд -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock Text="Батарея" FontSize="28" FontWeight="SemiBold" />
                    <ui:TextBlock Text="История разряда и оценка времени работы по режимам нагрузки."
                                  Opacity="0.6"
                                  Margin="0,4,0,0"
                                  TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPercent}"
                               FontSize="34"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CurrentState}"
                               Opacity="0.6"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- График -->
            <ui:Card Grid.Row="1" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Opacity="0.75"
                                   Text="Разряд и зарядка во времени" />
                        <ComboBox Grid.Column="1"
                                  Width="150"
                                  SelectionChanged="Window_Changed"
                                  x:Name="WindowCombo">
                            <ComboBoxItem Content="Последние 24 ч" Tag="Day" />
                            <ComboBoxItem Content="Последние 7 дней" Tag="Week" />
                        </ComboBox>
                    </Grid>

                    <Border CornerRadius="10"
                            Background="#0DFFFFFF"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="1"
                            Height="260">
                        <controls:BatteryChart x:Name="Chart"
                                               Revision="{Binding Revision}"
                                               WindowLabel="{Binding WindowLabel}" />
                    </Border>

                    <!-- Легенда -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="9" Height="9" Fill="#E81123" Margin="0,0,6,0" />
                        <TextBlock Text="разряд" FontSize="11" Opacity="0.75" Margin="0,0,18,0" />
                        <Ellipse Width="9" Height="9" Fill="#4CC711" Margin="0,0,6,0" />
                        <TextBlock Text="зарядка" FontSize="11" Opacity="0.75" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding SamplesText}" FontSize="11" Opacity="0.5" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Три карточки по режимам нагрузки -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Активная игра -->
                <ui:Card Grid.Column="0" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="🎮 Активная игра" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="1000 Гц и выше" FontSize="11" Opacity="0.5" Margin="0,2,0,10" />
                        <TextBlock Text="{Binding GamingRate}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GamingLeft}" Opacity="0.85" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GamingHint}" FontSize="11" Opacity="0.5"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Обычное использование -->
                <ui:Card Grid.Column="1" Padding="16" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="💻 Обычное использование" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="сёрфинг, документы" FontSize="11" Opacity="0.5" Margin="0,2,0,10" />
                        <TextBlock Text="{Binding NormalRate}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NormalLeft}" Opacity="0.85" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NormalHint}" FontSize="11" Opacity="0.5"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Ожидание -->
                <ui:Card Grid.Column="2" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="💤 Режим ожидания" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="сон, мышь не двигается" FontSize="11" Opacity="0.5"
                                   Margin="0,2,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IdleLeft}" FontSize="19" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IdleHint}" FontSize="11" Opacity="0.5"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Инфо о зарядке -->
            <ui:Card Grid.Row="3" Padding="18" Opacity="0.9">
                <StackPanel>
                    <ui:TextBlock Text="О заряде" FontSize="16" FontWeight="SemiBold"
                                  Margin="0,0,0,8" />
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Последняя зарядка" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding LastChargeText}"
                                   FontWeight="SemiBold" Margin="14,0,0,0" />
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Цикл текущего разряда" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding CycleText}"
                                   FontWeight="SemiBold" Margin="14,0,0,0"
                                   TextWrapping="Wrap" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>