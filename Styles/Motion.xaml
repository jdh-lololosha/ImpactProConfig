<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Easing Functions ===== -->
    <CubicEase x:Key="MotionEaseOutCubic" EasingMode="EaseOut"/>
    <QuarticEase x:Key="MotionEaseOutQuartic" EasingMode="EaseOut"/>
    <BackEase x:Key="MotionBackEaseOut" EasingMode="EaseOut" Amplitude="0.25"/>
    <ExponentialEase x:Key="MotionEaseInExpo" EasingMode="EaseIn"/>

    <!-- BackEase с амплитудой 0.35 - по требованию для OSD. Отдельный ресурс,
         потому что MotionBackEaseOut использует 0.25 и менять его здесь
         нельзя: он же применяется в других местах.

         ОБЪЯВЛЕН ДО MotionOsdEnter СОЗНАТЕЛЬНО. StaticResource не умеет
         forward reference: ресурс должен быть определён выше по файлу, чем
         место использования. При объявлении ниже сториборда парсер его
         не находил, но падал не сразу - лениво, при первой материализации
         словаря, то есть ровно в момент показа OSD:
         XamlParseException "не удается найти ресурс MotionOsdScaleEase",
         а вызов FindResource("MotionOsdEnter") не был в try/catch, и OSD
         ронял всё приложение. -->
    <BackEase x:Key="MotionOsdScaleEase" EasingMode="EaseOut" Amplitude="0.35"/>

    <!-- ===== OSD Enter: slide from bottom 30px + fade in, 250ms BackEase ===== -->
    <Storyboard x:Key="MotionOsdEnter">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.25"
                         EasingFunction="{StaticResource MotionBackEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="30" To="0" Duration="0:0:0.25"
                         EasingFunction="{StaticResource MotionBackEaseOut}"/>
        <!-- Масштаб 0.9 -> 1.0: окно «выпрыгивает» из центра. Путь через
             TransformGroup задан в OsdWindow (border.RenderTransform), иначе
             путь (UIElement.RenderTransform).(ScaleTransform.ScaleX) не
             разрешился бы - там лежит TranslateTransform. -->
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children).[1].(ScaleTransform.ScaleX)"
                         From="0.9" To="1.0" Duration="0:0:0.25"
                         EasingFunction="{StaticResource MotionOsdScaleEase}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children).[1].(ScaleTransform.ScaleY)"
                         From="0.9" To="1.0" Duration="0:0:0.25"
                         EasingFunction="{StaticResource MotionOsdScaleEase}"/>
    </Storyboard>

    <!-- ===== OSD Exit: fade out + 10px down, 150ms ExponentialEase ===== -->
    <Storyboard x:Key="MotionOsdExit">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.15"
                         EasingFunction="{StaticResource MotionEaseInExpo}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="0" To="10" Duration="0:0:0.15"
                         EasingFunction="{StaticResource MotionEaseInExpo}"/>
    </Storyboard>

    <!-- ===== Page Enter: Y 16→0 + fade in, 200ms CubicEase ===== -->
    <Storyboard x:Key="MotionPageEnter">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.2"
                         EasingFunction="{StaticResource MotionEaseOutCubic}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="16" To="0" Duration="0:0:0.2"
                         EasingFunction="{StaticResource MotionEaseOutCubic}"/>
    </Storyboard>

    <!-- Пружины нажатия здесь нет СОЗНАТЕЛЬНО.

         Стиль ImpactPressSpring жил здесь и был неявным для ui:Button в
         App.xaml. Это ломало тему: неявный стиль в Application.Resources
         перекрывает неявный стиль WPF-UI (MergedDictionaries - низший
         приоритет), а BasedOn вёл на стиль TargetType="ButtonBase" БЕЗ
         BasedOn, то есть без Background, Foreground и ControlTemplate.
         Кнопки теряли оформление и рисовались системными серыми
         квадратами с нечитаемым текстом.

         Обойти это BasedOn="{StaticResource {x:Type ui:Button}}" нельзя:
         разрешение неявного стиля привело бы к самому себе. Пружина
         реализована обработчиками PreviewMouseLeftButtonDown/Up на
         MainWindow (см. MainWindow.OnPressDown / OnPressUp) - они меняют
         только RenderTransform и не касаются Style. -->

</ResourceDictionary>
